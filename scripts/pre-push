#!/usr/bin/env bash
# Перед push: +0.001 к Version на экране входа PWA (index.html).
# Один раз после клона: npm run install-hooks
# Без авто-бампа: SKIP_PWA_VERSION_BUMP=1 git push

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [[ "${SKIP_PWA_VERSION_BUMP:-}" == "1" ]]; then
  exit 0
fi

node scripts/bump-pwa-login-version.js

if ! git diff --quiet index.html styles.css; then
  git add index.html styles.css
  git commit -m "chore: bump PWA login screen version"
fi

exit 0
