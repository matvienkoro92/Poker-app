{
  "name": "poker21-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "Приветственная страница покерного клуба Poker21 для Telegram Mini App.",
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "scripts": {
    "build": "node scripts/copy-to-public.js",
    "start": "npx serve .",
    "backup": "./scripts/backup.sh",
    "bump:pwa-version": "node scripts/bump-pwa-login-version.js",
    "install-hooks": "cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push scripts/backup.sh scripts/bump-pwa-login-version.js"
  }
}

